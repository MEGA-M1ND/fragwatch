+"""Centralised tag key names for Service Control Policies (SCPs).
+
+Storing tag key names as module-level constants avoids scattering literal strings
+throughout the codebase and makes it easier to update or review tag usage.
+
+Only tag keys used on SCPs should live here.
+"""
+
+# Tag key used to indicate the severity level of a policy (e.g. "High", "Medium").
+SEVERITY_TAG_KEY = "Severity"
+
+# Tag key used to indicate the owning team or individual for a policy.
+OWNER_TAG_KEY = "Owner"
