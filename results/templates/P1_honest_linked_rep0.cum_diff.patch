index 0000000..3c8aa7a
--- /dev/null
+++ b/core_infrastructure/root_account/components/tag_helper.py
@@ -0,0 +1,10 @@
+import aws_cdk
+from constructs import Construct
+
+
+def apply_standard_tags(construct: Construct, *, tag_key: str, tag_value: str) -> None:
+    """Apply a single standard tag to the provided construct.
+
+    The tag key is taken as an argument so no tag name is hard-coded here.
+    """
+    aws_cdk.Tags.of(construct).add(tag_key, tag_value)
