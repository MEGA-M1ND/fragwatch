new file mode 100644
index 0000000..a299656
--- /dev/null
+++ b/core_infrastructure/root_account/components/billing_alarms.py
@@ -0,0 +1,87 @@
+from aws_cdk import CfnOutput
+from aws_cdk import aws_budgets as budgets
+from aws_cdk import aws_iam as iam
+from aws_cdk import aws_sns as sns
+from constructs import Construct
+
+
+class BillingAlarms(Construct):
+    """Create billing budget alerts that publish to an SNS topic.
+
+    This creates an SNS topic named "org-billing-alarms" and a Cost budget
+    that triggers notifications when actual or forecasted monthly spend
+    is >= $100,000,000 (100M). Both notifications are configured at a
+    100% threshold.
+    """
+
+    def __init__(self, scope: Construct, **kwargs):
+        super().__init__(scope, "BillingAlarms", **kwargs)
+
+        # SNS Topic for billing alerts
+        self.topic = sns.Topic(self, "BillingAlarmTopic", display_name="org-billing-alarms")
+
+        # Allow AWS Budgets service to publish to the SNS topic
+        sns.TopicPolicy(
+            self,
+            "BillingAlarmTopicPolicy",
+            topics=[self.topic],
+            policy_document=iam.PolicyDocument(
+                statements=[
+                    iam.PolicyStatement(
+                        actions=["sns:Publish"],
+                        effect=iam.Effect.ALLOW,
+                        principals=[iam.ServicePrincipal("budgets.amazonaws.com")],
+                        resources=[self.topic.topic_arn],
+                    )
+                ]
+            ),
+        )
+
+        # Budget amount: 100,000,000 USD
+        budget_limit = budgets.CfnBudget.SpendProperty(amount=100000000, unit="USD")
+
+        # Notification for Actual >= 100%
+        actual_notification = budgets.CfnBudget.NotificationProperty(
+            comparison_operator="GREATER_THAN",
+            notification_type="ACTUAL",
+            threshold=100.0,
+            threshold_type="PERCENTAGE",
+        )
+
+        # Notification for Forecasted >= 100%
+        forecast_notification = budgets.CfnBudget.NotificationProperty(
+            comparison_operator="GREATER_THAN",
+            notification_type="FORECASTED",
+            threshold=100.0,
+            threshold_type="PERCENTAGE",
+        )
+
+        # Subscribers for both notifications (SNS)
+        subscriber = budgets.CfnBudget.SubscriberProperty(
+            address=self.topic.topic_arn, subscription_type="SNS"
+        )
+
+        CfnBudget = budgets.CfnBudget
+
+        # Create the budget with both notifications
+        CfnBudget(
+            self,
+            "OrgBillingBudget",
+            budget=budgets.CfnBudget.BudgetDataProperty(
+                budget_type="COST",
+                time_unit="MONTHLY",
+                budget_limit=budget_limit,
+                budget_name="Org-Monthly-Cost-Budget-100M",
+            ),
+            notifications_with_subscribers=[
+                budgets.CfnBudget.NotificationWithSubscribersProperty(
+                    notification=actual_notification, subscribers=[subscriber]
+                ),
+                budgets.CfnBudget.NotificationWithSubscribersProperty(
+                    notification=forecast_notification, subscribers=[subscriber]
+                ),
+            ],
+        )
+
+        # Output the SNS topic ARN for subscriptions
+        CfnOutput(self, "BillingSNSTopicArn", description="Billing alarm topic ARN.", value=self.topic.topic_arn)
