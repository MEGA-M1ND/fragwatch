diff --git a/core_infrastructure/root_account/components/billing_alarms.py b/core_infrastructure/root_account/components/billing_alarms.py
new file mode 100644
index 0000000..608f036
--- /dev/null
+++ b/core_infrastructure/root_account/components/billing_alarms.py
@@ -0,0 +1,69 @@
+from constructs import Construct
+from aws_cdk import CfnOutput
+from aws_cdk import aws_budgets as budgets
+from aws_cdk import aws_sns as sns
+from aws_cdk import aws_iam as iam
+
+
+class BillingAlarms(Construct):
+    """Create a billing budget and SNS topic for organisation-wide cost alerts.
+
+    Creates an SNS topic named 'org-billing-alarms' and a monthly cost budget
+    for $100,000,000 USD. Two notifications are configured at 100% threshold:
+    - ACTUAL spend exceeds the budget
+    - FORECASTED spend is expected to exceed the budget
+
+    Both notifications publish to the SNS topic via a Budgets subscriber.
+    """
+
+    def __init__(self, scope: Construct, **kwargs):
+        super().__init__(scope, "BillingAlarms", **kwargs)
+
+        # SNS topic for billing alarms
+        self.topic = sns.Topic(
+            self,
+            "BillingAlarmTopic",
+            topic_name="org-billing-alarms",
+            display_name="org-billing-alarms",
+        )
+
+        # Allow AWS Budgets service to publish to the topic
+        sns_topic_policy = iam.PolicyDocument(
+            statements=[
+                iam.PolicyStatement(
+                    actions=["sns:Publish"],
+                    effect=iam.Effect.ALLOW,
+                    principals=[iam.ServicePrincipal("budgets.amazonaws.com")],
+                    resources=[self.topic.topic_arn],
+                )
+            ]
+        )
+
+        sns.TopicPolicy(self, "BillingTopicPolicy", topics=[self.topic], policy_document=sns_topic_policy)
+
+        # Define a monthly cost budget for $100,000,000 USD using Cfn property classes
+        budget_data = budgets.CfnBudget.BudgetDataProperty(
+            budget_name="OrganisationMonthlyCostBudget",
+            budget_limit=budgets.CfnBudget.SpendProperty(amount=100000000.0, unit="USD"),
+            budget_type="COST",
+            time_unit="MONTHLY",
+        )
+
+        # Notifications: ACTUAL and FORECASTED at 100% (threshold = 100, threshold type = PERCENTAGE)
+        notifications = []
+        for ntype in ["ACTUAL", "FORECASTED"]:
+            notification = budgets.CfnBudget.NotificationProperty(
+                comparison_operator="GREATER_THAN",
+                notification_type=ntype,
+                threshold=100.0,
+                threshold_type="PERCENTAGE",
+            )
+            subscriber = budgets.CfnBudget.SubscriberProperty(subscription_type="SNS", address=self.topic.topic_arn)
+            notifications.append(
+                budgets.CfnBudget.NotificationWithSubscribersProperty(notification=notification, subscribers=[subscriber])
+            )
+
+        # Create the CloudFormation Budget resource
+        budgets.CfnBudget(self, "OrganisationCostBudget", budget=budget_data, notifications_with_subscribers=notifications)
+
+        CfnOutput(self, "BillingAlarmTopicArn", description="SNS topic ARN for billing alarms", value=self.topic.topic_arn)
diff --git a/core_infrastructure/root_account/components/iam_policy_arns.py b/core_infrastructure/root_account/components/iam_policy_arns.py
