@@ -0,0 +1,11 @@
+"""Centralised AWS managed policy ARNs used by emergency-access tooling.
+
+These constants centralise the ARNs so that emergency-access tooling and related
+utilities do not have scattered literal ARN strings throughout the codebase.
+
+Do not create roles or policies in this module; it only exposes string constants.
+"""
+
+READ_ONLY_POLICY_ARN = "arn:aws:iam::aws:policy/ReadOnlyAccess"
+POWER_USER_POLICY_ARN = "arn:aws:iam::aws:policy/PowerUserAccess"
+BREAK_GLASS_POLICY_ARN = "arn:aws:iam::aws:policy/AdministratorAccess"
diff --git a/core_infrastructure/root_account/components/managed_role_stackset.py b/core_infrastructure/root_account/components/managed_role_stackset.py
new file mode 100644
index 0000000..dc608f8
--- /dev/null
+++ b/core_infrastructure/root_account/components/managed_role_stackset.py
@@ -0,0 +1,68 @@
+import json
+
+from aws_cdk import Stack
+from aws_cdk import aws_cloudformation as cfn
+from constructs import Construct
+
+
+class ManagedRoleStackSet(Construct):
+    def __init__(
+        self,
+        scope: Construct,
+        construct_id: str,
+        *,
+        role_name: str,
+        policy_arns: list[str],
+        organisation_units: dict[str, object],
+        target_ou_name: str,
+        regions: list[str],
+    ) -> None:
+        super().__init__(scope, construct_id)
+
+        # Build a minimal CloudFormation template that provisions an IAM role with
+        # the requested managed policy ARNs attached. The principal is the root of
+        # the current account so the role can be assumed by that account root.
+        template = {
+            "AWSTemplateFormatVersion": "2010-09-09",
+            "Resources": {
+                "ManagedRole": {
+                    "Type": "AWS::IAM::Role",
+                    "Properties": {
+                        "RoleName": role_name,
+                        "AssumeRolePolicyDocument": {
+                            "Version": "2012-10-17",
+                            "Statement": [
+                                {
+                                    "Effect": "Allow",
+                                    "Action": "sts:AssumeRole",
+                                    "Principal": {
+                                        "AWS": f"arn:aws:iam::{Stack.of(self).account}:root"
+                                    },
+                                }
+                            ],
+                        },
+                        "ManagedPolicyArns": policy_arns,
+                    },
+                }
+            },
+        }
+
+        # Create the StackSet. Use service-managed permission model and named IAM
+        # capability since we are creating a role with a specific name.
+        cfn.CfnStackSet(
+            self,
+            "ManagedRoleStackSet",
+            stack_set_name=role_name + "StackSet",
+            template_body=json.dumps(template),
+            permission_model="SERVICE_MANAGED",
+            capabilities=["CAPABILITY_NAMED_IAM"],
+            auto_deployment=cfn.CfnStackSet.AutoDeploymentProperty(enabled=True),
+            stack_instances_group=[
+                cfn.CfnStackSet.StackInstancesProperty(
+                    deployment_targets=cfn.CfnStackSet.DeploymentTargetsProperty(
+                        organizational_unit_ids=[organisation_units[target_ou_name].ref]
+                    ),
+                    regions=regions,
+                )
+            ],
+        )
