diff --git a/core_infrastructure/root_account/components/billing_alarms.py b/core_infrastructure/root_account/components/billing_alarms.py
new file mode 100644
index 0000000..ade94e1
--- /dev/null
+++ b/core_infrastructure/root_account/components/billing_alarms.py
@@ -0,0 +1,73 @@
+from aws_cdk import CfnOutput
+from aws_cdk import aws_budgets as budgets
+from aws_cdk import aws_sns as sns
+from constructs import Construct
+
+
+class BillingAlarms(Construct):
+    """Create an SNS topic for billing alarms and a monthly budget that alerts
+    on actual and forecasted spend hitting 100% of a $100,000,000 USD limit.
+
+    The budget uses notifications with subscribers so that SNS is notified when
+    either the ACTUAL or FORECASTED cost reaches 100% of the budget.
+    """
+
+    def __init__(self, scope: Construct, **kwargs):
+        super().__init__(scope, "BillingAlarms", **kwargs)
+
+        # SNS topic for billing alarms. Use a fixed topic name so external systems
+        # can subscribe by name if required.
+        self.topic = sns.Topic(self, "BillingAlarmTopic", topic_name="org-billing-alarms")
+
+        # Define a budget of $100,000,000 USD per month and notify at 100% for
+        # both actual and forecasted spend.
+        budget_data = budgets.CfnBudget.BudgetDataProperty(
+            budget_type="COST",
+            time_unit="MONTHLY",
+            budget_limit=budgets.CfnBudget.SpendProperty(amount=100000000, unit="USD"),
+            # optional name could be set if desired
+        )
+
+        actual_notification = budgets.CfnBudget.NotificationWithSubscribersProperty(
+            notification=budgets.CfnBudget.NotificationProperty(
+                comparison_operator="GREATER_THAN",
+                notification_type="ACTUAL",
+                threshold=100.0,
+                threshold_type="PERCENTAGE",
+            ),
+            subscribers=[
+                budgets.CfnBudget.SubscriberProperty(
+                    subscription_type="SNS",
+                    address=self.topic.topic_arn,
+                )
+            ],
+        )
+
+        forecasted_notification = budgets.CfnBudget.NotificationWithSubscribersProperty(
+            notification=budgets.CfnBudget.NotificationProperty(
+                comparison_operator="GREATER_THAN",
+                notification_type="FORECASTED",
+                threshold=100.0,
+                threshold_type="PERCENTAGE",
+            ),
+            subscribers=[
+                budgets.CfnBudget.SubscriberProperty(
+                    subscription_type="SNS",
+                    address=self.topic.topic_arn,
+                )
+            ],
+        )
+
+        budgets.CfnBudget(
+            self,
+            "OrganisationBillingBudget",
+            budget=budget_data,
+            notifications_with_subscribers=[actual_notification, forecasted_notification],
+        )
+
+        CfnOutput(
+            self,
+            "BillingAlarmTopicArn",
+            description="ARN of the SNS topic receiving organisation billing alarms",
+            value=self.topic.topic_arn,
+        )
diff --git a/core_infrastructure/root_account/components/iam_policy_arns.py b/core_infrastructure/root_account/components/iam_policy_arns.py
new file mode 100644
index 0000000..d923750
