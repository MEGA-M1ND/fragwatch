+++ b/core_infrastructure/root_account/components/iam_policy_arns.py
@@ -0,0 +1,12 @@
+"""Centralised AWS-managed policy ARNs for emergency / break-glass tooling.
+
+These constants centralise the ARNs used by emergency-access tooling so they are
+not scattered as literals across the codebase. Only module-level constants are
+exposed here; this module does not create any IAM resources.
+"""
+
+# AWS-managed policy ARNs commonly referenced by emergency access tooling.
+READ_ONLY_POLICY_ARN = "arn:aws:iam::aws:policy/ReadOnlyAccess"
+POWER_USER_POLICY_ARN = "arn:aws:iam::aws:policy/PowerUserAccess"
+# The break-glass policy is intentionally the full AdministratorAccess managed policy.
+BREAK_GLASS_POLICY_ARN = "arn:aws:iam::aws:policy/AdministratorAccess"
diff --git a/core_infrastructure/root_account/components/managed_role_stackset.py b/core_infrastructure/root_account/components/managed_role_stackset.py
new file mode 100644
index 0000000..8576f8b
--- /dev/null
+++ b/core_infrastructure/root_account/components/managed_role_stackset.py
@@ -0,0 +1,63 @@
+import json
+from constructs import Construct
+from aws_cdk import Stack
+from aws_cdk import aws_cloudformation as cloudformation
+
+
+class ManagedRoleStackSet(Construct):
+    def __init__(
+        self,
+        scope: Construct,
+        construct_id: str,
+        *,
+        role_name: str,
+        policy_arns: list,
+        organisation_units: dict,
+        target_ou_name: str,
+        regions: list,
+    ):
+        super().__init__(scope, construct_id)
+
+        # Build a simple CloudFormation template body that creates a single IAM Role
+        template = {
+            "Resources": {
+                role_name: {
+                    "Type": "AWS::IAM::Role",
+                    "Properties": {
+                        "RoleName": role_name,
+                        "AssumeRolePolicyDocument": {
+                            "Version": "2012-10-17",
+                            "Statement": [
+                                {
+                                    "Effect": "Allow",
+                                    "Action": "sts:AssumeRole",
+                                    "Principal": {
+                                        "AWS": f"arn:aws:iam::{Stack.of(self).account}:root"
+                                    },
+                                }
+                            ],
+                        },
+                        "ManagedPolicyArns": policy_arns,
+                    },
+                }
+            }
+        }
+
+        # Create the StackSet using the rendered template body
+        cloudformation.CfnStackSet(
+            self,
+            "ManagedRoleStackSet",
+            stack_set_name=role_name + "StackSet",
+            template_body=json.dumps(template),
+            permission_model="SERVICE_MANAGED",
+            capabilities=["CAPABILITY_NAMED_IAM"],
+            auto_deployment=cloudformation.CfnStackSet.AutoDeploymentProperty(enabled=True),
+            stack_instances_group=[
+                cloudformation.CfnStackSet.StackInstancesProperty(
+                    deployment_targets=cloudformation.CfnStackSet.DeploymentTargetsProperty(
+                        organizational_unit_ids=[organisation_units[target_ou_name].ref]
+                    ),
+                    regions=regions,
+                )
+            ],
+        )
